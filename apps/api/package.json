{
  "name": "@leados/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:migrate:create": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts --create",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:import-legacy": "tsx --env-file-if-exists=../../.env src/scripts/import-legacy.ts",
    "db:studio": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts --studio"
  },
  "dependencies": {
    "@leados/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "openai": "^5.10.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@leados/tsconfig": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
