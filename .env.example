# LeadOS environment variables. Copy to `.env` in the repo root (never commit real values).
# The API loads this file automatically in development (`pnpm dev`, `pnpm db:*`).

# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL. Defaults to postgresql://localhost:5432/leados_v2 (the user name defaults to
# $PGUSER or your OS user). On Neon, use the pooled ("-pooler") connection string here.
DATABASE_URL=postgresql://localhost:5432/leados_v2
# Optional: direct (non-pooled) connection used for migrations. On Neon, the same string
# without "-pooler" in the host. Defaults to DATABASE_URL.
DATABASE_DIRECT_URL=

# Secret for signing access tokens. REQUIRED in production: at least 32 random characters,
# e.g. `openssl rand -base64 48`. The API refuses to start in production without it.
JWT_SECRET=

# Public URL of the app (the web app and API share one origin). In development the Vite
# dev server on :5173 proxies /api to the API, so no CORS is needed.
APP_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (nginx, Caddy, a load balancer) so
# rate limiting sees the real client IP.
TRUST_PROXY=false

# ─── AI (lead scoring + Instagram auto-replies) ─────────────────────────────
# Set ONE key. Without any key, lead scoring uses built-in rules, AI replies stay off and no
# data is sent anywhere.
# Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (fast, free tier available): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: gemini | groq | openai. If empty, the first key set above is used (in that order).
AI_PROVIDER=
# Optional model override. Defaults: gemini-2.5-flash, llama-3.3-70b-versatile, gpt-4o-mini.
# (OPENAI_MODEL still works for OpenAI when AI_MODEL is empty.)
AI_MODEL=

# ─── Instagram (DM + comment inbox) ─────────────────────────────────────────
# true = no calls to Meta: a sandbox answers instead, you can connect a "Test account" with any
# token and send fake messages from Settings → Instagram. Defaults to true in development.
INSTAGRAM_TEST_MODE=
# Long-lived Instagram token (Meta dashboard → Instagram → API setup with Instagram login →
# "Generate token"). When set, LeadOS connects the account by itself on start-up and subscribes
# the webhook — nothing to do in Settings. Leave empty to connect from Settings instead.
INSTAGRAM_ACCESS_TOKEN=
# The previous LeadOS names INSTAGRAM_APP_SECRET and INSTAGRAM_WEBHOOK_VERIFY_TOKEN are also
# accepted for the two values below, so an existing deployment's settings keep working.
# Meta app → App settings → Basic → App secret (for the Instagram product: Instagram → API
# setup with Instagram login → "Instagram app secret"). Used to verify webhook signatures.
META_APP_SECRET=
# Any random string; paste the same value as "Verify token" when adding the webhook in the Meta
# dashboard. If empty, one is derived from JWT_SECRET and shown in Settings → Instagram.
META_WEBHOOK_VERIFY_TOKEN=
# Public https address of this app that Meta can reach (webhook callback =
# PUBLIC_URL/api/webhooks/instagram). Defaults to APP_ORIGIN. For local testing run e.g.
# `cloudflared tunnel --url http://localhost:4000` and paste the https://….trycloudflare.com URL.
PUBLIC_URL=
# Graph API version for graph.instagram.com calls.
INSTAGRAM_GRAPH_VERSION=v23.0
# Optional: key for encrypting the stored Instagram token (at least 32 characters). If empty,
# a key is derived from JWT_SECRET — changing either means reconnecting Instagram.
ENCRYPTION_KEY=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# bcrypt work factor for password hashes (4–15).
BCRYPT_COST=12

# Optional: where the built web app lives (defaults to apps/web/dist). Only used in production.
WEB_DIST_DIR=

# Used by `pnpm db:seed` to create the first admin. If the password is empty, one is
# generated and printed.
SEED_ADMIN_EMAIL=admin@leados.local
SEED_ADMIN_PASSWORD=
